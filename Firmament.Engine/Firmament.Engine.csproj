<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<LangVersion>default</LangVersion>
		<RootNamespace>Firmament.Engine</RootNamespace>
		<AssemblyName>Firmament.Engine</AssemblyName>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup>
		<CSharpier_Check>false</CSharpier_Check>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="CSharpier.MsBuild" Version="1.3.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Firmament.Rendering\Firmament.Rendering.csproj" />
	</ItemGroup>
</Project>
